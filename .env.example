# PostgreSQL 17 (Render). Never commit the real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Prefer a restricted Stripe test key with Checkout Sessions write access.
STRIPE_SECRET_KEY=rk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_MODE=test

# Injected automatically by Vercel. Production + live mode requires a Live key;
# Preview and local environments accept Test keys only.
VERCEL_ENV=preview

# Canonical public origin used for Stripe redirects.
PUBLIC_SITE_URL=https://gadgetsmania.org
